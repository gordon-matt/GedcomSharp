<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>GedcomSharp</RootNamespace>
		<Description>Read and write GEDCOM 5.5, 5.5.1, 5.5.5 and 7.0 (including GEDZIP), and GEDCOM X JSON, XML and .gedx files. Lossless round-trips, tolerant reading of real-world files, and typed records over the raw structure tree.</Description>
		<Authors>Matt Gordon</Authors>
		<PackageTags>gedcom;gedcom7;gedcomx;gedzip;genealogy;family-tree;ansel</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1573</NoWarn>
		<Company>Matt Gordon</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/gordon-matt/GedcomSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/GedcomSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\_Misc\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GedcomSharp.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
